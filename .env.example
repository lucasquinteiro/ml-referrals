# Copy to .env and fill in. Everything is read from the real environment first,
# so in GitHub Actions set these as repository secrets instead of committing a file.

# --- Mercado Libre affiliate ------------------------------------------------
# From your Programa de Afiliados dashboard. Generate one link there and copy
# the matt_word (tag) and matt_tool (tool id) values out of it.
ML_AFFILIATE_TAG=
ML_AFFILIATE_TOOL_ID=

# --- Twitter/X: official API (post_target: twitter_api) ----------------------
# From developer.x.com -> your app -> Keys and tokens. The app needs Read+Write,
# and regenerate the access token AFTER setting that permission.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# --- Twitter/X: cookie auth (only for post_target: twitter_cookie) -----------
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# --- Slack (optional) --------------------------------------------------------
# Incoming Webhook. Every ingest posts a summary of what it found.
SLACK_WEBHOOK_URL=

# --- Sessions for CI (optional) ----------------------------------------------
# GitHub Actions has no browser to log in with, so the session is carried in as
# JSON. Paste the whole contents of the matching state/ml-session-<role>.json.
# Locally you don't need these — ./run login writes the files directly.
# ML_AFFILIATE_STORAGE_STATE=
# ML_STORAGE_STATE=

# --- Tweet copy (optional) ---------------------------------------------------
# Without a key the pipeline falls back to templated copy, which works fine.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Storage (only when config.json "store" is "supabase") -------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
