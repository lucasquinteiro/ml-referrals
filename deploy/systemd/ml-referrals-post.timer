[Unit]
Description=ml-referrals — post 5 times a day

[Timer]
# Five tweets a day, spread across the active Buenos Aires window (setup.sh sets
# the box timezone) — 5 slots: 11,14,17,20,23. `post` sends exactly one, so this
# cadence IS the rate limit. The random delay keeps it off the exact hour.
OnCalendar=*-*-* 11,14,17,20,23:30
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
