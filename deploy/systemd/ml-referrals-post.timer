[Unit]
Description=ml-referrals — post every 3 hours

[Timer]
# 8 tweets a day. `post` sends exactly one, so this cadence IS the rate limit.
# Offset from the ingest timer so they don't start together (the gate would
# serialise them anyway, but staggering keeps the logs clean).
OnCalendar=*-*-* 01,04,07,10,13,16,19,22:30
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
