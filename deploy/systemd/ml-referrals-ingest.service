[Unit]
Description=ml-referrals — scrape Mercado Libre /ofertas listings, snapshot prices
OnFailure=ml-referrals-failure@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mlref
WorkingDirectory=/opt/ml-referrals
EnvironmentFile=/opt/ml-referrals/.env
# /ofertas only: anonymous, no login wall, and keywords still filter the haul.
# The keyword-`search` source is paused — it sits behind an intermittent ML
# account-verification interstitial that failed the whole job and paged Slack.
ExecStart=/opt/ml-referrals/.venv/bin/python run.py ingest --source ofertas --pages 2
TimeoutStartSec=3600
Nice=10

[Install]
WantedBy=multi-user.target
